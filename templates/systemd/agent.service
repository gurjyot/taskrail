[Unit]
Description=TaskRail managed automation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=smg-automation
WorkingDirectory=/opt/smg-automations/automations/REPLACE_NAME
ExecStartPre=/usr/bin/env taskrail-heartbeat %N starting
ExecStart=/usr/bin/node /opt/smg-automations/automations/REPLACE_NAME/main.js
ExecStopPost=/usr/bin/env taskrail-heartbeat %N systemd
TimeoutStartSec=5min
MemoryMax=512M
CPUQuota=100%
TasksMax=64
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/smg-automations/state/REPLACE_NAME /opt/smg-automations/automations/REPLACE_NAME

[Install]
WantedBy=multi-user.target
