[Unit]
Description=TaskRail managed automation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=private-automation
WorkingDirectory=/opt/taskrail-automations/automations/REPLACE_NAME
ExecStartPre=/usr/bin/taskrail-heartbeat REPLACE_NAME starting
ExecStart=/usr/bin/node /opt/taskrail-automations/automations/REPLACE_NAME/main.js
ExecStopPost=/usr/bin/taskrail-heartbeat REPLACE_NAME systemd
TimeoutStartSec=5min
MemoryMax=512M
CPUQuota=100%
TasksMax=64
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/taskrail-automations/state/REPLACE_NAME /opt/taskrail-automations/automations/REPLACE_NAME

[Install]
WantedBy=multi-user.target
