{
  "name": "taskrail-template",
  "taskrailCompatibility": "2.1.x",
  "profile": "smg-node-timer@1",
  "runtime": "node",
  "managed": true,
  "sourceDir": "src",
  "validationCommand": "node --check src/index.js",
  "testCommand": "node --test tests/*.test.js",
  "requiredSharedFiles": [],
  "requiredChecks": ["validation", "test", "health"],
  "healthCheck": { "type": "command", "command": "node --check src/index.js" }
}
