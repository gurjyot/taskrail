{
  "schema": 1,
  "repositories": [
    {
      "name": "taskrail-capabilities",
      "kind": "capabilities",
      "path": "../taskrail-capabilities",
      "required": true,
      "enforceCurrentMajor": true,
      "checks": [
        { "command": "npm", "args": ["test"] },
        { "command": "npm", "args": ["run", "check"] }
      ]
    },
    {
      "name": "taskrail-automations",
      "kind": "automations",
      "path": "../taskrail-automations",
      "required": true,
      "enforceCurrentMajor": true,
      "checks": [
        { "command": "npm", "args": ["test"] },
        { "command": "npm", "args": ["run", "check"] }
      ]
    },
    {
      "name": "private-automations",
      "kind": "automations",
      "path": "../private-automations",
      "required": false,
      "enforceCurrentMajor": true
    }
  ]
}
